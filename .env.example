# ===========================================================================
# ZATCA Integration — environment variables
# ===========================================================================
# Two consumers read this file:
#
#   1) `docker compose up`  — auto-loads variables for docker-compose.yml.
#   2) Local Go CLIs (process_bills, credit_notes, etc.) — use the lowercase
#      DB names below (HOST/PORT/DBUSER/PASSWORD/DBNAME), not the compose ones.
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# ===========================================================================

# ---------------------------------------------------------------------------
# (A) docker-compose.yml — daemon container
# ---------------------------------------------------------------------------

# Authorized private ZATCA SDK root used only as a Docker build context.
# It must contain Apps/fatoora, Configuration/, and Data/.
# Never commit the SDK or credentials to this repository.
ZATCA_SDK_PATH=                    # <-- REQUIRED for Docker image builds

# Database connection (required)
DB_USER=zatca_daemon
DB_PASS=changeme                 # <-- REQUIRED
DB_HOST=host.docker.internal     # host machine MySQL
DB_PORT=3306
MASTER_DB=zatca_master

# Optional: scope tenant discovery by environment database prefix.
# Set TENANT_NAME_PREFIX (e.g. dev- -> tenant_dev_, prod- -> tenant_prod_)
# and/or TENANT_DB_PREFIX (e.g. tenant_dev_ or tenant_prod_). If both are set,
# they must agree or daemon startup and --verify-db fail closed.
# TENANT_NAME_PREFIX=
# TENANT_DB_PREFIX=

# Optional: separate admin user used only during onboarding
# ADMIN_DB_USER=
# ADMIN_DB_PASS=

# AES-256-GCM key for encrypting ZATCA credentials in the DB (required).
# Generate with:  openssl rand -base64 32
ENCRYPT_KEY=                     # <-- REQUIRED

# Password for the embedded NATS monitoring endpoint https://host:8222 (required).
MONITOR_PASS=                    # <-- REQUIRED

# Credentials for the embedded NATS client endpoint (required in production).
# Use the same values in the backend's NATS_URL or client configuration.
NATS_USER=                       # <-- REQUIRED
NATS_PASSWORD=                   # <-- REQUIRED

# TLS files for the NATS endpoint. These are host paths and are mounted
# read-only into the daemon. Set all three for the default TLS mode. Leave
# them blank only when every NATS client/server path is on a trusted private
# network and NATS_PRIVATE_NETWORK_ONLY=true.
NATS_PRIVATE_NETWORK_ONLY=false
NATS_TLS_CERT_FILE=
NATS_TLS_KEY_FILE=
NATS_TLS_CA_FILE=
NATS_TLS_SERVER_NAME=nats

# NATS monitoring uses the server certificate/key above when provided.
# Without TLS, keep it on a trusted private network and retain MONITOR_PASS.
# Compose publishes ports 4222/8222 on the host; firewall them from untrusted
# networks. An HTTP reverse proxy does not protect raw NATS TCP.
# NATS_MONITOR_HOST=0.0.0.0
# NATS_MONITOR_LOCAL_TEST_MODE=false

# Compose never enables local unauthenticated mode. Private-network mode
# permits plaintext transport but does not remove NATS authentication.
# NATS_LOCAL_TEST_MODE=false

# Host port mappings (override only if 4222/8222 collide with another service)
# NATS_PORT=4222
# NATS_MONITOR_PORT=8222

# SMTP for daemon error-alert emails (optional; defaults to host SMTP on :25)
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=zatca-daemon@localhost

# ---------------------------------------------------------------------------
# (B) Local Go CLIs in cmd/  (NOT used by docker compose)
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3306
DBUSER=zatca_daemon
PASSWORD=
DBNAME=dev_ifritah

# ---------------------------------------------------------------------------
# (C) Dev-only — used by scripts/, not by Go or compose
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
